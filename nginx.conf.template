server {
    listen 80;
    root /usr/share/nginx/html;
    index index.html;

    # /api → Immich
    location /api/ {
        proxy_pass ${IMMICH_URL}/api/;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_buffering off;
        client_max_body_size 0;
        proxy_read_timeout 300;
    }

    # Static
    location / {
        try_files $uri /Page.html;
    }
}
